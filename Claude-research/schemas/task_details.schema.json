{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hed-cognitive.org/schemas/task_details.schema.json",
  "title": "HED task catalog",
  "description": "Schema for task_details.json — the canonical catalog of experimental tasks/paradigms in the HED (Hierarchical Event Descriptor) project. Top-level is a bare array of task objects (not a wrapping dict, unlike process_details.json). Covers structural shape only; cross-checks (e.g., hed_process_ids resolve to processes in process_details.json) live in Python.",

  "type": "array",
  "items": { "$ref": "#/definitions/task" },

  "definitions": {

    "task": {
      "type": "object",
      "required": [
        "hedtsk_id",
        "canonical_name",
        "short_definition",
        "description",
        "inclusion_test",
        "hed_process_ids"
      ],
      "properties": {
        "hedtsk_id": {
          "type": "string",
          "pattern": "^hedtsk_[a-z][a-z0-9_]*$",
          "description": "Task identifier with hedtsk_ prefix."
        },
        "canonical_name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Plain string list — note this differs from process_details.json, where aliases are objects with name+note."
        },
        "short_definition": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "inclusion_test": { "$ref": "#/definitions/inclusion_test" },
        "variations": {
          "type": "array",
          "items": { "$ref": "#/definitions/variation" }
        },
        "atlas_id": {
          "type": ["string", "null"],
          "description": "Cognitive Atlas task ID; null when no Atlas equivalent."
        },
        "source_task_numbers": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "status": {
          "type": "string",
          "description": "Editorial status; current single value is 'complete' but kept open-typed for future states."
        },
        "hed_process_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^hed_[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "description": "Process IDs implicated by this task. Each must resolve to a process in process_details.json (cross-check enforced in Python, not here)."
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/definitions/reference" }
        }
      }
    },

    "inclusion_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure", "manipulation", "measurement"],
      "properties": {
        "procedure": { "type": "string", "minLength": 1 },
        "manipulation": { "type": "string", "minLength": 1 },
        "measurement": { "type": "string", "minLength": 1 }
      }
    },

    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "justification"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 }
      }
    },

    "reference": {
      "type": "object",
      "required": ["roles", "ids", "oa_status"],
      "description": "Same shape as the reference object in process_details.schema.json. Identifiers live in a nested 'ids' block (see id_set definition there); 'url' and 'pub_id' stay at the top level. Schema reorganised 2026-05-19; see .status/plan_2026-05-19_rec1_v2.md.",
      "properties": {
        "roles": {
          "type": "array",
          "items": { "$ref": "#/definitions/reference_role" },
          "minItems": 1
        },
        "title": { "type": ["string", "null"] },
        "authors": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"] },
        "journal": { "type": ["string", "null"] },
        "venue": { "type": ["string", "null"] },
        "venue_type": { "type": ["string", "null"] },
        "volume": { "type": ["string", "null"] },
        "issue": { "type": ["string", "null"] },
        "pages": { "type": ["string", "null"] },
        "ids": { "$ref": "#/definitions/id_set" },
        "url": { "type": ["string", "null"] },
        "pub_id": { "type": ["string", "null"] },
        "oa_status": { "$ref": "#/definitions/oa_status" },
        "pdf_locations": {
          "type": "array",
          "description": "Discovered PDF locations; see process_details.schema.json#/definitions/pdf_location for the per-item shape. Populated by enrich_pdf_locations.py.",
          "items": { "$ref": "#/definitions/pdf_location" }
        },
        "local_artifacts": { "$ref": "#/definitions/local_artifacts" },
        "citation_string": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "confidence": { "type": ["string", "null"] },
        "verified_on": { "type": ["string", "null"] }
      }
    },

    "id_set": {
      "type": "object",
      "description": "Nested block of external identifiers; mirrors process_details.schema.json#/definitions/id_set. additionalProperties:false to catch typos.",
      "additionalProperties": false,
      "properties": {
        "doi":         { "type": ["string", "null"] },
        "openalex_id": { "type": ["string", "null"] },
        "pmid":        { "type": ["string", "null"] },
        "pmcid":       { "type": ["string", "null"] },
        "s2_id":       { "type": ["string", "null"] },
        "arxiv_id":    { "type": ["string", "null"] }
      }
    },

    "oa_status": {
      "type": "string",
      "enum": [
        "gold",
        "hybrid",
        "green",
        "bronze",
        "closed",
        "diamond",
        "unknown"
      ],
      "description": "Open-access status enum following OpenAlex's vocabulary, plus 'unknown' for refs not yet enriched. See process_details.schema.json#/definitions/oa_status for the design rationale around the bronze case."
    },

    "pdf_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "source"],
      "description": "A single known PDF location; mirrors process_details.schema.json#/definitions/pdf_location. See that schema for full field documentation.",
      "properties": {
        "url":     { "type": "string", "minLength": 1 },
        "source":  { "type": "string" },
        "version": { "type": ["string", "null"] },
        "is_oa":   { "type": ["boolean", "null"] },
        "license": { "type": ["string", "null"] }
      }
    },

    "local_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "On-disk PDF and/or Markdown acquired for this publication; mirrors process_details.schema.json#/definitions/local_artifacts. See that schema for the design rationale (independent licences per artifact).",
      "properties": {
        "pdf": { "$ref": "#/definitions/local_artifact_entry" },
        "markdown": { "$ref": "#/definitions/local_artifact_entry" }
      }
    },

    "local_artifact_entry": {
      "type": "object",
      "additionalProperties": false,
      "description": "One acquired artifact OR a failure-record placeholder; see process_details.schema.json#/definitions/local_artifact_entry for full field documentation and the D-E2 design rationale (success/failure two-shape design locked 2026-05-27).",
      "properties": {
        "path":            { "type": ["string", "null"] },
        "source_url":      { "type": ["string", "null"] },
        "source_type":     { "type": "string" },
        "license":         { "type": "string" },
        "acquired_on":     { "type": "string" },
        "acquired_via":    { "type": ["string", "null"] },
        "converter":       { "type": ["string", "null"] },
        "is_publishable":  { "type": ["boolean", "null"] },
        "last_attempt":    { "type": "string" },
        "attempts":        { "type": "integer", "minimum": 1 },
        "tried":           { "type": "array", "items": { "type": "string" } },
        "reason":          { "type": "string" }
      },
      "if": {
        "properties": { "path": { "type": "string" } },
        "required": ["path"]
      },
      "then": {
        "required": ["source_type", "license"],
        "properties": {
          "path": { "type": "string", "minLength": 1 }
        }
      },
      "else": {
        "required": ["last_attempt"]
      }
    },

    "reference_role": {
      "type": "string",
      "enum": [
        "historical",
        "review",
        "experiment",
        "dataset",
        "other",
        "unknown"
      ],
      "description": "Role vocabulary fixed by CLAUDE.md (2026-04-23)."
    }
  }
}
