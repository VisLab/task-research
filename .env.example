# Environment variables this repo's scripts read. Copy to .env (gitignored)
# or set in your shell; environment variables always take priority.
#
# This repo also reads Claude-research/code/.apikeys (gitignored, one
# KEY=value line per key) as a fallback for the API keys below.

# Semantic Scholar API key. Optional: does not lift the 1 request/second
# search rate limit, but identifies the caller and enables auth-scoped
# endpoints.
S2_API_KEY=

# NCBI E-utilities API key. Optional; not used by the current pipeline.
NCBI_API_KEY=

# Polite-pool contact email sent as mailto= on every Crossref and OpenAlex
# call. Required for the polite pool's faster rate limits.
OPENALEX_MAILTO=

# Root directory for the shared API response cache. Optional; when unset,
# scripts fall back to outputs/cache/ under the workspace.
HED_CACHE_DIR=
