{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python code/*)",
      "Bash(python -m pytest *)",
      "Bash(python -m pytest)",
      "Bash(pytest *)",
      "Bash(pytest)",
      "Bash(python -m unittest *)",
      "Bash(python -m ruff *)",
      "Bash(python -c *)",
      "Bash(python --version)",
      "Bash(python -m pip list)",
      "Bash(python -m pip show *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(typos)",
      "Bash(typos *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git remote -v)",
      "Bash(git ls-files *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(file *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(source .venv/Scripts/activate)",
      "Bash(. .venv/Scripts/activate)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout HEAD -- *)",
      "Bash(git restore *)",
      "Bash(git stash *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.envrc)",
      "Read(.status/archive/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch *)",
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(python -m pip install *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(chmod *)",
      "Bash(chown *)"
    ]
  }
}
